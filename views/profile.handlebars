<div class="profile">
  <div class="container">
    <h1 id="userInfo" user-id="{{profileUser.id}}">{{profileUser.username}}'s Profile</h1>
    {{#if user}}
      {{#if followed}}
      <button id="follow-button">Unfollow</button>  
      {{else}}
      <button id="follow-button">Follow</button>
      {{/if}}
    {{else}} 
    <h3>Login to follow this uer</h3>
    {{/if}}

    

{{> all-posts posts=profileUserPosts comments=comments blog_user=profileUser}}

  </div>

</div>

<script src="/js/profile.js"></script>