<div class="profile">
  <div class="profile-header">
    <div class="profile-info">
      <h1 id="userInfo" user-id="{{profileUser.id}}">{{profileUser.username}}'s Profile</h1>
      {{#if user}}
        {{#if followed}}
        <button id="follow-button">Unfollow</button>  
        {{else}}
        <button id="follow-button">Follow</button>
        {{/if}}
      {{else}} 
      <h3>Login to follow this user</h3>
      {{/if}}
    </div>
    
    <div class="friends">
      <h4>{{profileUser.username}}'s followers</h4>
      {{#each followers as |follower|}}
      <ul>
        <li><a href="/profile/{{follower.id}}">{{follower.username}}</a></li>
      </ul>
      {{/each}}
  </div>

  </div>



  {{> all-posts posts=profileUserPosts comments=comments blog_user=profileUser}}

</div>

<script src="/js/profile.js"></script>