<div class="all-posts">
  {{#if posts.length}}

  {{#each posts as |post| }}
  <div class="card" id="{{post.id}}">
    <div class="title">
      <h2> {{post.title}} </h2>
      <p> Posted by <a href="/profile/{{blog_user.id}}">{{ blog_user.username }}</a> on {{format_date post.date_created}}</p>
    </div>
    <div class="content">
      <p> {{post.content}} </p>
    </div>
    <div class="comments">
      <button class="collapse-comment-box">Collapse Box</button>
      {{#each comments as |comment|}}
        <div class="comment">
          <p class="comment-content">{{comment.content}}</p>
          {{#if blog_user.username}}
          <p class="user-comment">-{{blog_user.username}}, {{format_date comment.date_created}}</p>
          {{else}}
          <p class="user-comment">-anonymous, {{format_date comment.date_created}}</p>
          {{/if}}
        </div>
      {{/each}}

      <div class="comment-box" data-post-id="{{post.id}}">      
        <form>
          <label for="comment-input-post{{post.id}}">Comment</label>
          <textarea maxlength='220' class="comment-content" id="comment-input-post{{post.id}}" name="comment" maxlength="200" placeholder="Enter your comment"></textarea>
          <button class="comment-btn" data-post-id="{{post.id}}">submit</button>
        </form>        
      </div>
    </div>
    
  </div>
  {{/each}}

  {{/if}}
  <script src="/js/all-posts.js"></script>
</div>



   